<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1C1C1E">

    <!-- Display Area -->
    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/display_default"
        android:textSize="48sp"
        android:textColor="#FFFFFF"
        android:gravity="end"
        android:padding="16dp"
        android:background="#2C2C2E"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Button Grid -->
    <GridLayout
        android:id="@+id/gridButtons"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="4"
        android:rowCount="5"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvDisplay"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#FF453A"
            android:contentDescription="@string/desc_clear"
            android:text="@string/btn_clear"
            android:textColor="#212121"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn7"      android:text="@string/btn_7"      android:contentDescription="@string/desc_7"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn8"      android:text="@string/btn_8"      android:contentDescription="@string/desc_8"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn9"      android:text="@string/btn_9"      android:contentDescription="@string/desc_9"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btnDiv"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#FF9F0A"
            android:contentDescription="@string/desc_div"
            android:text="@string/btn_div"
            android:textColor="#5D4037"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn4"      android:text="@string/btn_4"      android:contentDescription="@string/desc_4"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn5"      android:text="@string/btn_5"      android:contentDescription="@string/desc_5"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn6"      android:text="@string/btn_6"      android:contentDescription="@string/desc_6"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btnMul"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#FF9F0A"
            android:contentDescription="@string/desc_mul"
            android:text="@string/btn_mul"
            android:textColor="#5D4037"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn1"      android:text="@string/btn_1"      android:contentDescription="@string/desc_1"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn2"      android:text="@string/btn_2"      android:contentDescription="@string/desc_2"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn3"      android:text="@string/btn_3"      android:contentDescription="@string/desc_3"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btnSub"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#FF9F0A"
            android:contentDescription="@string/desc_sub"
            android:text="@string/btn_sub"
            android:textColor="#5D4037"
            tools:ignore="VisualLintButtonSize" />
        <Button android:id="@+id/btn0"      android:text="@string/btn_0"      android:contentDescription="@string/desc_0"        android:backgroundTint="#3A3A3C" android:textColor="#FFF" android:layout_columnWeight="1" android:layout_rowWeight="1" android:layout_width="0dp" android:layout_height="0dp" android:layout_margin="4dp"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btnEquals"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#30D158"
            android:contentDescription="@string/desc_equals"
            android:text="@string/btn_equals"
            android:textColor="#5D4037"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#FF9F0A"
            android:contentDescription="@string/desc_add"
            android:text="@string/btn_add"
            android:textColor="#5D4037"
            tools:ignore="VisualLintButtonSize" />

        <!-- Row 5: Custom Operator (spans full width) -->
        <Button
            android:id="@+id/btnCustom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnSpan="4"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:backgroundTint="#0A84FF"
            android:contentDescription="@string/desc_custom"
            android:text="@string/btn_custom"
            android:textColor="#000000"
            tools:ignore="VisualLintButtonSize" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>